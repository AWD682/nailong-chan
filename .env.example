# Copy this file to .env and fill in the credentials for your own QQ bot and AI provider.
DRIVER=~aiohttp
QQ_BOTS=[]
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Optional: comma-separated group IDs for proactive chat.
ACTIVE_GROUP_OPENIDS=

# Optional: quiz generation can use a separate AI provider.
QUIZ_API_KEY=
QUIZ_MODEL=
